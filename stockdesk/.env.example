# stockdesk/.env 템플릿. 복사해서 stockdesk/.env로 저장한다 (git 제외, 권한 600 권장: umask 077).
# 값에 따옴표를 붙이지 않는다. 키는 로그·출력·커밋에 절대 남기지 않는다.
# 토스증권 Open API (시세 조회만 사용. 주문·계좌 코드는 없다). 허용 IP에 실행 머신의 공인 IP를 등록해야 한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# DART Open API (공시, DT·TH 장부). https://opendart.fss.or.kr 에서 발급
DART_API_KEY=
# Finnhub (US 실적 캘린더, 선택)
FINNHUB_API_KEY=
